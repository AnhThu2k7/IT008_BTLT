<Window x:Class="BTLT01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BTLT01"
        FontFamily="Times New Roman"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1200">
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
            <StackPanel>
                <GroupBox Header="Form điền thông tin sinh viên" Margin="0,0,0,10" Padding="10">
                    
                    <StackPanel x:Name="GetInfor">
                        
                        <!--Ảnh đại diện-->
                        <StackPanel>
                            
                            <Border Width="110" Height="110" BorderBrush="#D1D5DB" BorderThickness="2" CornerRadius="55">
                                <Border.Clip>
                                    <EllipseGeometry Center="55,55" RadiusX="55" RadiusY="55"/>
                                </Border.Clip>
                                <Image x:Name="imgAddAvatar" Stretch="UniformToFill"/>
                            </Border>
                            
                            <Button Content="Chọn ảnh" FontSize="15" Width="100" Height="27" Margin="0,10,0,0"  BorderThickness="0" Click="btnChooseImage_Click" />
                        </StackPanel>
                        
                        <!--MSSV-->
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="MSSV:" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox x:Name="txtStudentId" TextWrapping="Wrap" Padding="5" ToolTip="Nhập mã số sinh viên" Foreground="DarkSlateGray" VerticalContentAlignment="Center" Height="25"/>
                        </StackPanel>
                        
                        
                        <!--Họ tên-->
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Họ và tên:" FontSize="15" FontWeight="Bold"  Margin="0,0,0,2"/>
                            <TextBox x:Name="txtFullName" Height="25" Padding="5" ToolTip="Nhập họ tên sinh viên" TextWrapping="Wrap" Foreground="DarkSlateGray" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        

                        <!--Ngày sinh và giới tính-->
                        <Grid Margin="0,10,0,0">
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Ngày sinh:" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,0,0,2"/>
                                <DatePicker x:Name="dpDateOfBirth" Height="30" Padding="5" Language="vi-VN" Foreground="DarkSlateGray"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Giới tính:" FontSize="15" FontWeight="Bold"  Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal" Height="28">
                                    <RadioButton x:Name="rbMale" Content="Nam" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <RadioButton x:Name="rbFemale" Content="Nữ"  FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>

                        <!--Trường-->
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Trường:" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
                            <ComboBox x:Name="cboUniversity" Height="25" VerticalContentAlignment="Center" SelectedIndex="5" Padding="5">
                                <ComboBoxItem Content="UIT - VNUHCM"/>
                                <ComboBoxItem Content="USSH - VNUHCM"/>
                                <ComboBoxItem Content="HCMUS - VNUHCM"/>
                                <ComboBoxItem Content="RMIT University"/>
                                <ComboBoxItem Content="FPT University"/>
                                <ComboBoxItem Content="Chọn trường học"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <!--Button Xoá, Thêm-->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                            <Button Content="Xóa" FontSize="15" Width="75" Height="27" Margin="0,0,5,0" BorderThickness="0" Click="btnRemoveStudent_Click"/>
                            <Button Content="Thêm" FontSize="15" Width="75" Height="27" Background="CornflowerBlue" BorderThickness="0" Click="btnAddStudent_Click"/>
                        </StackPanel>
                        
                    </StackPanel>
                </GroupBox>
                
                <!--Hiển thị thông tin sinh viên--> 
                <GroupBox Header="Xem thông tin sinh viên" Padding="10">

                    <Grid Height="265">
                        <TextBlock Text="Hãy chọn 1 sinh viên từ danh sách." 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Foreground="DarkSlateGray"/>
                        <local:UserDetail x:Name="ucUserDetail" DataContext="{Binding ElementName=lvDanhSachSV, Path=SelectedItem}" Visibility="Collapsed"/>
                    </Grid>

                </GroupBox>
                
            </StackPanel>
        </ScrollViewer>

        <!--Hiển thị dữ liệu sinh viên và chức năng lọc-->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
            <StackPanel x:Name="CotPhai">
                
                <!--Lọc dữ liệu--> 
                <GroupBox Header="Tìm sinh viên" Padding="10">
                    
                    <Grid>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtSearch" Grid.Column="0" ToolTip="Tìm theo tên, MSSV" TextChanged="txtSearch_TextChanged" Foreground="DarkSlateGray"  Height="25" VerticalContentAlignment="Center" Margin="0,0,10,0" Padding="5"/>

                        <ComboBox x:Name="cboFilter" Grid.Column="1" Height="25" SelectedIndex="5" Padding="5" SelectionChanged="cboFilter_SelectionChanged">
                            <ComboBoxItem Content="UIT - VNUHCM"/>
                            <ComboBoxItem Content="USSH - VNUHCM"/>
                            <ComboBoxItem Content="HCMUS - VNUHCM"/>
                            <ComboBoxItem Content="RMIT University"/>
                            <ComboBoxItem Content="FPT University"/>
                            <ComboBoxItem Content="Chọn trường học"/>
                        </ComboBox>

                    </Grid>
                </GroupBox>

                <!--Hiển thị dữ liệu sinh viên-->
                <GroupBox Header="Danh sách sinh viên" Padding="10" Margin="0,10,0,0" Height="487">
                    <ListView x:Name="lvDanhSachSV" SelectionChanged="lvDanhSachSV_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="MSSV" DisplayMemberBinding="{Binding StudentId}" Width="100"/>
                                <GridViewColumn Header="Họ và tên" DisplayMemberBinding="{Binding FullName}" Width="180"/>
                                <GridViewColumn Header="Giới tính" DisplayMemberBinding="{Binding Gender}" Width="100"/>
                                <GridViewColumn Header="Ngày sinh" DisplayMemberBinding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <GridViewColumn Header="Trường" DisplayMemberBinding="{Binding University}" Width="300"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
